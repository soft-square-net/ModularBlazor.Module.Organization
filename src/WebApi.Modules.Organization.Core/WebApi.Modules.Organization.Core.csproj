<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    Core (the domain model of the central Organization service): orgs (customers), unit types, the unit tree, persons,
    memberships, positions, tenant seeds, tenant links and the change feed, one folder per aggregate with its
    specifications. Its rules throw DomainException (the endpoints answer 409).
    References Organization.Contracts only, for the shared vocabulary (unit paths, binding/seed/link states), which
    has no dependencies. The Module SDK compiles it against WebApi.SharedKernel and Ardalis.Specification (host).
  -->

  <PropertyGroup>
    <ModuleLayer>Domain</ModuleLayer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Organization.Contracts\Organization.Contracts.csproj" />
  </ItemGroup>

</Project>
